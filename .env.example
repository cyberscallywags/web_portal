# Cyber Scallywags UK — environment template
# Copy to `.env` and fill in real values. Do not commit `.env`.
#
# IMPORTANT: docker-compose's env_file parser is strict. Use `KEY=value`
# with NO spaces around `=`, or the variable will be silently dropped and
# the app will crash with KeyError on startup.

# --- Neo4j (required) -------------------------------------------------------
# Aura connection string, e.g. neo4j+ssc://xxxxxxxx.databases.neo4j.io
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
# Optional — defaults to "neo4j" if unset
NEO4J_DATABASE=neo4j

# --- Logfire (optional) -----------------------------------------------------
# Generate at https://logfire.pydantic.dev → Settings → Write tokens
LOGFIRE_TOKEN=
